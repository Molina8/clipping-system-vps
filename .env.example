# ==============
# Clipping API
# ==============
# Copia este archivo a .env y rellena los valores reales.
# NUNCA subas .env a Git.

# --- Database (PostgreSQL) ---
CLIPPING_DB_HOST=127.0.0.1
CLIPPING_DB_PORT=5432
CLIPPING_DB_NAME=clipping
CLIPPING_DB_USER=clipping_api
CLIPPING_DB_PASSWORD=<change-me-strong-password>

# --- API server ---
API_HOST=100.109.27.21
API_PORT=8080
# Token Bearer que el Worker envía en Authorization: Bearer <API_TOKEN>
# Genera uno fuerte: openssl rand -hex 32
API_TOKEN=<change-me-generate-with-openssl-rand-hex-32>

# --- App ---
ENVIRONMENT=production
LOG_LEVEL=INFO

# --- Mission Control (solo lectura) ---
# Activa el dashboard. Default False — solo se monta si está a true.
MISSION_CONTROL_ENABLED=true
# Base URL que el frontend prepende a asset.local_path y clip.file_path
# para hacerlos clickables. Vacío = se muestran como texto literal.
# Ejemplos:
#   worker_file_base_url=https://worker.tailnet.ts.net:8443
#   worker_file_base_url=file:///C:/CODIANT/clipping/data
WORKER_FILE_BASE_URL=
